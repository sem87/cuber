# ==============================================================================
# .GITIGNORE ДЛЯ PYTHON / FASTAPI ПРОЕКТА
# ==============================================================================

# ==========================================
# 1. СЕКРЕТЫ И КОНФИГУРАЦИЯ (КРИТИЧНО!)
# Пароли, токены и ключи НИКОГДА не должны быть в Git.
# ==========================================
.env
.env.local
.env.term
env.term
.env.wallet
env.wallet
.env.*.local
config/local_settings.py

# Специфичные файлы проекта (Т-Банк, Telegram, трейдинг)
credentials.json
tiker_figi.json
token.pickle
MAR.session
MAR.session-journal
SEM.session
SEM.session-journal

# ==========================================
# 2. PYTHON: Кэш и артефакты
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg
tiker_figi.json
# ==========================================
# 3. ВИРТУАЛЬНЫЕ ОКРУЖЕНИЯ
# ==========================================
venv/
.venv/
env/
ENV/
venv.bak/
env.bak/

# ==========================================
# 4. БАЗЫ ДАННЫХ (SQLite)
# Локальные БД не коммитим, чтобы не тащить тестовые данные.
# ==========================================
*.sqlite3
*.sqlite
*.db
sql_terminator.db
# database.db  # Раскомментируй, если используется конкретное имя файла

# ==========================================
# 5. ЛОГИ И ВРЕМЕННЫЕ ДАННЫЕ
# ==========================================
*.log
logs/
informing/
inform.log
loGgGi.log
trade.log
system.log
debug.log
tmp/
temp/

# ==========================================
# 6. IDE И РЕДАКТОРЫ
# ==========================================
.idea/
*.iml
.vscode/
*.code-workspace
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ==========================================
# 7. АРТЕФАКТЫ СБОРКИ
# ==========================================
build/
dist/
sdist/
wheels/
pip-wheel-metadata/
share/python-wheels/
.eggs/
develop-eggs/
parts/
var/
downloads/

