# ==============================================================================
# .DOCKERIGNORE ДЛЯ PYTHON ПРОЕКТА
# ==============================================================================

# ==========================================
# 1. СЕКРЕТЫ И КОНФИГУРАЦИЯ (КРИТИЧНО!)
# Эти файлы НИКОГДА не должны попадать в Docker-образ.
# ==========================================
# Файлы окружения
.env
.env.*
*.env
.env.term
logicuber.py
# Ключи и сертификаты
*.pem
*.key
*.p12
*.pfx
secrets/
credentials/

# Токены и авторизация
token.pickle
credentials.json

# Конфиги, которые монтируются через volumes (не нужны в образе)
tiker_figi.json

# Сессии Pyrogram (монтируются через volumes как папка)
*.session
SEM.session
*.session-journal
*.session-wal
session/

# Базы данных (монтируются через volumes)
*.db
*.sqlite
*.sqlite3
sql_terminator.db
#credentials.json
# ==========================================
# 2. PYTHON: Виртуальные окружения и кэш
# Внутри контейнера зависимости ставятся заново.
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
.venv/
env/
ENV/
pip-log.txt
pip-delete-this-directory.txt
.mypy_cache/
.ruff_cache/

# ==========================================
# 3. GIT И CI/CD
# ==========================================
.git/
.gitignore
.gitmodules
.github/

# ==========================================
# 4. ФАЙЛЫ DOCKER
# Инструкции по сборке не нужны внутри собранного образа.
# ==========================================
Dockerfile*
docker-compose*
.dockerignore

# ==========================================
# 5. РЕДАКТОРЫ КОДА И IDE
# ==========================================
.idea/
*.iml
.vscode/
*.code-workspace
*.swp
*.swo
.DS_Store
Thumbs.db

# ==========================================
# 6. ТЕСТЫ, ДОКУМЕНТАЦИЯ И ВРЕМЕННЫЕ ФАЙЛЫ
# ==========================================
tests/
test/
specs/
docs/
README*
LICENSE*
CHANGELOG*
*.md
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# ==========================================
# 7. ЛОГИ И ВРЕМЕННЫЕ ДАННЫЕ
# ==========================================
tmp/
temp/
logs/
log/
*.log
data/